y <- matrix(c(2,2,1,1,0,
1,0,0,1,1,
12,10,14,17,11,
7,9,15,8,10),nrow=4,byrow=T)
m=sum(y)/20; t=rowMeans(y)-m
e=apply(y,2,"-",rowMeans(y))
d=e/sqrt(sum(e^2)/16)
#-------------------------------------------#
#TESTES DE NORMALIDADE
library(nortest)
p=data.frame(Lilliefors=lillie.test(d)$p.value,
"Shapiro-Wilk"=shapiro.test(d)$p.value,
"Kolmogorov-Smirnov"=ks.test(d,pnorm)$p.value)
#-------------------------------------------#
#GRAFICO 1
par(mar=c(4.1,4.1,2,1))
qqnorm(d,pch=19,ylab="Standardized Residuals")
qqline(d,col="red")
abline(h=2,col="#FF0000A0",lty=2)
#-------------------------------------------#
#TESTE FMAX DE HARTLEY
variancias=apply(d,1,var)
estatistica <- max(variancias)/min(variancias)
#-------------------------------------------#
#GRAFICO 2
estim=t+m
plot(rep(estim,times=5),as.vector(d),
xlab="Valor Estimado",ylab="Resíduo Padronizado")
