library(kableExtra)
y=matrix(c(2,2,1,1,0,
1,0,0,1,1,
12,10,14,17,11,
7,9,15,8,10),nrow=4,byrow=T)
rownames(y)=LETTERS[1:4]
knitr::kable(y)
m=sum(y)/20
t=apply(y,1,mean)-m
names(t) <- paste0("$\\hat t_",c(1:4),"$")
knitr::kable(t(t))
e=apply(y,2,"-",t+m)
colnames(e) <- paste0("$\\hat e_{i",c(1:5),"}$")
rownames(e)=LETTERS[1:4]
kbl(e,digits=2,escape=F,booktabs=T,position = "h")|>
kable_styling(full_width = F,latex_options = "HOLD_position")
s=sqrt(sum(e^2)/16)
d=e/s
colnames(d) <- paste0("$\\hat d_{i",c(1:5),"}$")
kbl(d,digits=2,escape=F,booktabs=T,position = "h")|>
kable_styling(full_width = F,latex_options = "HOLD_position")
library(nortest)
p=data.frame(Lilliefors=lillie.test(d)$p.value,
"Shapiro-Wilk"=shapiro.test(d)$p.value,
"Kolmogorov-Smirnov"=ks.test(d,pnorm)$p.value)
rownames(p) <- "Valor p"
knitr::kable(p,digits=3)
par(mar=c(4.1,4.1,2,1))
qqnorm(d,pch=19,ylab="Standardized Residuals")
qqline(d,col="red")
abline(h=2,col="#FF0000A0",lty=2)
t
m+t
d
